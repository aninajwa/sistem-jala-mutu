# Port dev server (default 5173)
PORT=5173
# Base path aplikasi (default "/")
BASE_PATH=/
# Alamat backend untuk proxy /api saat development
VITE_API_PROXY_TARGET=http://localhost:5000

# Supabase: gunakan proyek yang sama dengan backend. Jangan gunakan service_role/secret key.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Development memakai proxy /api. Production: URL backend termasuk /api.
VITE_API_BASE_URL=/api
# Mode demo hanya dapat aktif saat development.
VITE_ENABLE_ROLE_TESTING=false
