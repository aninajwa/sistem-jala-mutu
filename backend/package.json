{
  "name": "jala-mutu-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "node ./build.mjs",
    "start": "node --env-file-if-exists=.env --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:push": "drizzle-kit push --config ./drizzle.config.ts",
    "codegen": "orval --config ./orval.config.ts",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "express": "^5.2.1",
    "multer": "2.4.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "orval": "^8.30.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "typescript": "~5.9.3"
  }
}
