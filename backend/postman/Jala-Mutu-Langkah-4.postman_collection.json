            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/paket/{{paket_id}}/checklist-persiapan",
        "description": "Jalankan 09 dahulu. Hanya dua item dihantar; item lain kekal. Ya atau Tidak ialah jawapan, null mengosongkan jawapan. Jika keterangan tidak dihantar, catatan lama kekal. Versi lapuk memberi 409: baca semula melalui 09. Request ini menyimpan data sebenar, bukan simulasi.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"expected_version\": {{checklist_version}},\n  \"jawaban\": [\n    {\n      \"item_id\": {{checklist_item_1}},\n      \"jawaban\": \"Ya\",\n      \"keterangan\": \"UJIAN - Semakan sumber data awal\"\n    },\n    {\n      \"item_id\": {{checklist_item_2}},\n      \"jawaban\": \"Tidak\",\n      \"keterangan\": \"UJIAN - Masih menunggu dokumen\"\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (String(pm.variables.get(\"checklist_paket_id\")) !== String(pm.variables.get(\"paket_id\")) || pm.variables.get(\"checklist_version\") === \"\" || !pm.variables.get(\"checklist_item_1\") || !pm.variables.get(\"checklist_item_2\")) {",
              " pm.execution.skipRequest();",
              " throw new Error(\"Jalankan 09 — Baca checklist persiapan untuk paket ini dahulu.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
