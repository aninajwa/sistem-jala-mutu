              " const d = pm.response.json().data;",
              " pm.collectionVariables.set(\"checklist_version\", String(d.pengisian.versi));",
              " pm.test(\"Kekal DRAFT\", () => pm.expect(d.pengisian.status).to.eql(\"DRAFT\"));",
              " pm.test(\"Belum ada kelulusan submit\", () => pm.expect(d.ringkasan.syarat_submit_aktif).to.eql(false));",
